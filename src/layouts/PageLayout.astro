---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import type { ComponentProps } from 'astro/types';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  lang?: string;
  headerData: ComponentProps<typeof Header>;
  footerData: ComponentProps<typeof Footer>;
}

const { metadata, lang, headerData, footerData } = Astro.props;
---

<Layout metadata={metadata} lang={lang}>
  <slot name="header">
    <Header {...headerData} isSticky position="right" showToggleTheme />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>

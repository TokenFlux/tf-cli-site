---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Terminal from '~/components/terminal/Terminal.astro';
import Install from '~/components/Install.astro';
import { dictionaries, type Locale } from '~/i18n/ui';
import { heroSessions } from '~/data/hero-session';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaries[locale];

const repo = 'https://github.com/TokenFlux/tf-cli';
const docs = 'https://docs.tokenflux.dev';

// 构建时取最新 release，失败时回落到最近已知版本，构建不依赖外网可用性。
let releaseTag = 'v0.10.0';
let releaseUrl = `${repo}/releases/latest`;
try {
  const res = await fetch('https://api.github.com/repos/TokenFlux/tf-cli/releases/latest', {
    headers: { 'User-Agent': 'tf-cli-site-build', Accept: 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = await res.json();
    if (typeof data?.tag_name === 'string') {
      releaseTag = data.tag_name;
      releaseUrl = typeof data.html_url === 'string' ? data.html_url : releaseUrl;
    }
  }
} catch {
  /* 离线或限流时使用回落版本号 */
}
---

<section class="hero" id="product">
  <div class="hero-mesh" aria-hidden="true"></div>
  <div class="hero-dots" aria-hidden="true"></div>
  <div class="hero-inner">
    <a class="release-badge" href={releaseUrl}>
      <span class="release-dot"></span>{releaseTag}{' '}{t.hero.releaseSuffix}<Icon name="tabler:arrow-up-right" />
    </a>
    <h1 set:html={t.hero.title} />
    <p class="hero-sub">
      <strong>{t.hero.offer}</strong>
      <span set:html={t.hero.description} />
    </p>
    <div class="hero-actions">
      <Button variant="primary" href="#install" icon="tabler:arrow-down-right">{t.hero.install}</Button>
      <Button href={repo} icon="tabler:brand-github">{t.hero.source}</Button>
    </div>
    <div class="hero-terminal">
      <Terminal frames={heroSessions[locale]} label={t.hero.terminalLabel} />
    </div>
    <dl class="hero-stats">
      {
        t.stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section class="clients" aria-label="Supported clients">
  <div class="clients-inner">
    <span class="clients-caption" set:html={t.clients.caption} />
    <span class="client-chip"
      ><span class="client-orb"><Icon name="client-claudecode" class="claude-icon" /></span>Claude Code</span
    >
    <span class="client-chip"><span class="client-orb"><Icon name="client-codex" /></span>Codex</span>
    <span class="client-chip"><span class="client-orb"><Icon name="client-opencode" /></span>OpenCode</span>
    <span class="client-chip"><span class="client-orb"><Icon name="client-pi" /></span>Pi</span>
  </div>
</section>

<section class="section" id="why-tf" aria-labelledby="why-title">
  <div class="section-head">
    <p class="eyebrow">{t.why.tagline}</p>
    <h2 id="why-title">{t.why.title}</h2>
    <p class="section-sub">{t.why.subtitle}</p>
  </div>
  <div class="feature-grid">
    {
      t.why.items.map((item) => (
        <article class="feature-card group">
          <div class={`card-visual visual-${item.visual}`} aria-hidden="true">
            {item.visual === 'inject' && (
              <div class="mini-window">
                <div class="mini-row">
                  <span class="mini-prompt">$</span>
                  <span class="mini-bar w-cmd" />
                </div>
                <div class="mini-row">
                  <span class="mini-key" />
                  <span class="mini-arrow">→</span>
                  <span class="mini-bar w-lg" />
                </div>
                <div class="mini-row">
                  <span class="mini-key" />
                  <span class="mini-arrow">→</span>
                  <span class="mini-bar w-md" />
                </div>
                <div class="mini-row">
                  <span class="mini-key" />
                  <span class="mini-arrow">→</span>
                  <span class="mini-bar w-sm" />
                </div>
              </div>
            )}
            {item.visual === 'keys' && (
              <div class="mini-keys">
                <span class="key-pill">
                  <Icon name="tabler:key" />
                  <span class="mini-bar w-md" />
                </span>
                <span class="key-pill">
                  <Icon name="tabler:key" />
                  <span class="mini-bar w-sm" />
                </span>
                <span class="key-link" />
              </div>
            )}
            {item.visual === 'slots' && (
              <div class="mini-slots">
                <div class="slot-row">
                  <span class="slot-chip" />
                  <span class="mini-bar w-lg" />
                  <Icon name="tabler:check" class="slot-check" />
                </div>
                <div class="slot-row">
                  <span class="slot-chip dim" />
                  <span class="mini-bar w-md" />
                  <Icon name="tabler:check" class="slot-check" />
                </div>
                <div class="slot-row">
                  <span class="slot-chip dim" />
                  <span class="mini-bar w-sm" />
                  <Icon name="tabler:check" class="slot-check" />
                </div>
              </div>
            )}
            {item.visual === 'probe' && (
              <div class="mini-probe">
                <span class="probe-orb">
                  <Icon name="tabler:shield-check" />
                </span>
                <div class="probe-rows">
                  <span class="mini-bar w-lg" />
                  <span class="mini-bar w-md" />
                </div>
              </div>
            )}
          </div>
          <div class="card-body">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a class="text-link" href={docs}>
              {t.why.link}
              <Icon name="tabler:arrow-right" />
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="workflow-section" aria-labelledby="workflow-title">
  <div class="workflow-inner">
    <div class="workflow-copy">
      <p class="eyebrow">{t.workflow.eyebrow}</p>
      <h2 id="workflow-title" set:html={t.workflow.title} />
      <p>{t.workflow.copy}</p>
      <a class="text-link" href={docs}>{t.workflow.link}<Icon name="tabler:arrow-up-right" /></a>
    </div>
    <div class="command-examples" aria-label="One-off launch flags">
      {
        t.workflow.examples.map((ex) => (
          <div>
            <span>{ex.label}</span>
            <code>
              <b>{ex.cmd.split(' ')[0]}</b> {ex.cmd.split(' ').slice(1).join(' ')}
            </code>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="trust-band" aria-label="Security boundaries">
  <div>
    <Icon name="tabler:shield-lock" aria-hidden="true" />
    <strong>{t.trust.strong}</strong>
    <p>{t.trust.copy}</p>
    <a class="text-link" href={`${repo}/blob/main/SECURITY.md`}>{t.trust.link}<Icon name="tabler:arrow-up-right" /></a>
  </div>
</section>

<Install t={t} version={releaseTag} />

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="section-head">
    <p class="eyebrow">{t.faq.tagline}</p>
    <h2 id="faq-title">{t.faq.title}</h2>
  </div>
  <div class="faq-grid">
    {
      t.faq.items.map((item) => (
        <div class="faq-item">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))
    }
  </div>
</section>

<section class="closing">
  <div>
    <p class="eyebrow">{t.closing.eyebrow}</p>
    <h2>{t.closing.title}</h2>
    <div class="closing-actions">
      <Button variant="primary" href="#install" icon="tabler:terminal-2">{t.closing.install}</Button>
      <Button href={docs} icon="tabler:arrow-up-right">{t.closing.docs}</Button>
    </div>
  </div>
  <span class="closing-mark" aria-hidden="true">tf<span>_</span></span>
</section>

---
import type { Frame, Segment } from '~/data/hero-session';

export interface Props {
  frames: Frame[];
  label: string;
}

const { frames, label } = Astro.props;

// 服务端渲染最终态：无 JS、prefers-reduced-motion、爬虫都能看到完整会话。
// clear 帧在静态渲染时变成分隔行，完整呈现每一屏；JS 播放时才真的清屏。
type Line = { text?: string; tone: string; parts?: Segment[] };
const lines: Line[] = [];
for (const frame of frames) {
  if (frame.kind === 'clear') {
    lines.push({ text: '────────────────────────', tone: 'faint' });
  } else if (frame.kind === 'type') {
    lines.push({ text: `$ ${frame.text}`, tone: 'typed' });
  } else {
    lines.push({ text: frame.text, tone: frame.tone ?? 'plain', parts: frame.parts });
  }
}
---

<div class="terminal" role="img" aria-label={label}>
  <div class="terminal-chrome" aria-hidden="true">
    <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
    <span class="terminal-title">Terminal — tf</span>
  </div>
  <div class="terminal-body" data-frames={JSON.stringify(frames)}>
    {
      lines.map((line) => (
        <div class={`term-line term-${line.tone}${line.parts?.some((p) => p.tone === 'claude') ? ' term-art' : ''}`}>
          {line.parts
            ? line.parts.map((p) => <span class={p.tone ? `term-${p.tone}` : undefined}>{p.text}</span>)
            : line.text}
        </div>
      ))
    }
  </div>
</div>

<script>
  import type { Frame } from '~/data/hero-session';

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  function span(text: string, tone?: string) {
    const el = document.createElement('span');
    if (tone) el.className = `term-${tone}`;
    el.textContent = text;
    return el;
  }

  async function play(body: HTMLElement) {
    const frames: Frame[] = JSON.parse(body.dataset.frames || '[]');
    if (!frames.length) return;

    for (;;) {
      // 页面不可见时等待，避免后台白跑
      while (document.hidden) await sleep(500);
      body.textContent = '';
      for (const frame of frames) {
        if (frame.kind === 'clear') {
          await sleep(frame.delay ?? 800);
          body.textContent = '';
          continue;
        }
        if (frame.kind === 'type') {
          const row = document.createElement('div');
          row.className = 'term-line term-typed';
          const prompt = span('$ ', 'term-prompt');
          const text = document.createElement('span');
          const cursor = document.createElement('span');
          cursor.className = 'term-cursor';
          row.append(prompt, text, cursor);
          body.append(row);
          for (const ch of frame.text) {
            text.textContent += ch;
            await sleep(55 + Math.random() * 70);
          }
          cursor.remove();
          await sleep(320);
        } else {
          const d = frame.delay ?? 400;
          if (d > 0) await sleep(d);
          const row = document.createElement('div');
          row.className = `term-line term-${frame.tone ?? 'plain'}`;
          if (frame.parts) {
            row.append(...frame.parts.map((p) => span(p.text, p.tone)));
            if (frame.parts.some((p) => p.tone === 'claude')) row.classList.add('term-art');
          } else {
            row.textContent = frame.text ?? '';
          }
          body.append(row);
        }
      }
      // 播完停留后循环
      await sleep(7000);
    }
  }

  document.querySelectorAll<HTMLElement>('.terminal-body[data-frames]').forEach((body) => {
    if (REDUCED) return; // 保留服务端渲染的最终态
    play(body).catch(() => {
      /* 播放失败时保留当前内容即可 */
    });
  });
</script>

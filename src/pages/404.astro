---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { getHomePermalink } from '~/utils/permalinks';
---

<Layout metadata={{ title: '页面不存在', robots: { index: false } }}>
  <section class="mx-auto max-w-3xl px-6 py-24 text-center">
    <p class="eyebrow">404</p><h1 class="text-4xl font-bold mb-6">这个页面不存在。</h1>
    <p class="text-muted mb-8">产品介绍在首页，使用文档在 TokenDocs。</p>
    <Button href={getHomePermalink()} variant="primary">返回首页</Button>
  </section>
</Layout>

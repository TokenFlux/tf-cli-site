---
// 根路径按浏览器语言跳转到默认 locale 或中文版。
// Astro i18n 的 redirectToDefaultLocale 需要存在一个根 index 页。
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>tf-cli</title>
    <meta http-equiv="refresh" content={`0; url=${base}en/`} />
    <script is:inline define:vars={{ base }}>
      const lang = (navigator.language || '').toLowerCase();
      location.replace(base + (lang.startsWith('zh') ? 'zh-cn' : 'en') + '/');
    </script>
  </head>
  <body></body>
</html>
